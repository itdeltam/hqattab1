# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file. It is already in .gitignore.

# --- Trading mode ---
# PAPER    (default) - Alpaca paper-trading endpoint, no real money, no confirmation needed.
# APPROVAL - Same as PAPER for order simulation today; reserved for a future
#            human-in-the-loop order approval flow. Still no real money.
# LIVE     - Real money, real broker endpoint. Requires typed confirmation
#            ("ENABLE LIVE TRADING") at every process startup. The app will
#            NEVER switch itself from PAPER/APPROVAL to LIVE.
TRADING_MODE=PAPER

# --- Alpaca credentials (never log these) ---
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Database ---
DATABASE_URL=sqlite:///./data/trading_bot.db

# --- Capital & risk limits ---
# FILL IN REAL NUMBERS BEFORE ANY LIVE TRADING. These placeholders are
# conservative examples only, not recommendations.
STARTING_CAPITAL=100000
MAX_DAILY_LOSS_PCT=0.02
MAX_WEEKLY_LOSS_PCT=0.05
MAX_DRAWDOWN_PCT=0.15
MAX_POSITION_PCT=0.10

# --- Leverage (off unless explicitly enabled) ---
ALLOW_LEVERAGE=false
MAX_LEVERAGE=1.0

# --- Monitoring ---
# How many seconds without a heartbeat before the engine is considered
# stale/hung and the dashboard + Telegram alert fire.
HEARTBEAT_STALE_SECONDS=120

# --- Logging ---
LOG_LEVEL=INFO
